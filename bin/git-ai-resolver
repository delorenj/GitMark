#!/bin/bash
# git-ai-resolver - AI-powered autonomous git conflict resolution
# Part of GitMark - https://github.com/delorenj/GitMark
# Usage: git-ai-resolver [resolution_mode]
#   resolution_mode: "rebase" (default) or "merge"
#
# SUBMODULE (gitlink) conflicts are resolved DETERMINISTICALLY, before any AI is
# consulted. A submodule conflict ("commits don't follow merge-base", "Merge
# conflict in <submodule>") is a pointer divergence, not a text conflict: the two
# sides record different submodule commits. There is nothing to diff/merge as
# text - cat-ing the path or grepping for <<<<<<< markers is meaningless. So we
# pick a commit structurally: the descendant when one side is an ancestor of the
# other, otherwise the NEWEST by committer date. This is mode-agnostic (it never
# relies on ours/theirs, which SWAP under rebase) and needs no network or AI.
#   Override with GITMARK_SUBMODULE_CONFLICT = newest (default) | ours | theirs.
#
# Environment:
#   GITMARK_SUBMODULE_CONFLICT  How to pick a commit when a submodule pointer
#                               conflicts: newest (default) | ours | theirs.

set -euo pipefail

RESOLUTION_MODE="${1:-rebase}"

# Resolve SCRIPT_DIR through symlinks (portable, no GNU readlink -f)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Config
CONFIG_FILE="${GITMARK_CONFIG:-$HOME/.config/GitMark/config.toml}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

log() {
    echo -e "${BLUE}[gitmark]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[gitmark] WARNING:${NC} $1"
}

error() {
    echo -e "${RED}[gitmark] ERROR:${NC} $1"
}

success() {
    echo -e "${GREEN}[gitmark]${NC} $1"
}

# --- git-dir helpers (work in submodules/worktrees, where .git is a FILE) ---
git_dir() { git rev-parse --git-dir 2>/dev/null; }

rebase_in_progress() {
    local gd; gd="$(git_dir)" || return 1
    [[ -d "$gd/rebase-merge" || -d "$gd/rebase-apply" ]]
}

merge_in_progress() {
    local gd; gd="$(git_dir)" || return 1
    [[ -f "$gd/MERGE_HEAD" ]]
}

# Check if we're in the middle of a conflict resolution
is_in_conflict() {
    rebase_in_progress && return 0
    merge_in_progress && return 0
    local gd; gd="$(git_dir)" || gd=".git"
    # cherry-pick / revert in progress
    if [[ -f "$gd/CHERRY_PICK_HEAD" ]] || [[ -f "$gd/REVERT_HEAD" ]]; then
        return 0
    fi
    # Unmerged index entries
    if git diff --name-only --diff-filter=U 2>/dev/null | grep -q .; then
        return 0
    fi
    return 1
}

# --- Submodule (gitlink) conflict handling -------------------------------------
# A conflicted path is a submodule when any of its unmerged index stages has the
# gitlink mode 160000, or it is declared in .gitmodules.
is_submodule_path() {
    local path="$1"
    if git ls-files --stage --error-unmatch -- "$path" 2>/dev/null | grep -q '^160000 '; then
        return 0
    fi
    if [[ -f .gitmodules ]] \
        && git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
        | awk '{print $2}' | grep -qx "$path"; then
        return 0
    fi
    return 1
}

# Decide which submodule commit to keep. Echoes the chosen SHA.
# Strategy (mode-agnostic, so the rebase ours/theirs swap can't bite us):
#   GITMARK_SUBMODULE_CONFLICT=ours   -> stage 2
#   GITMARK_SUBMODULE_CONFLICT=theirs -> stage 3
#   newest (default): descendant if one is an ancestor of the other, else the
#                     commit with the newer committer date. Falls back to
#                     whichever object actually exists locally if the other is
#                     unfetchable (offline).
select_submodule_commit() {
    local path="$1" ours="$2" theirs="$3"
    local mode="${GITMARK_SUBMODULE_CONFLICT:-newest}"
    (
        cd "$path" 2>/dev/null || { echo "$ours"; exit 0; }
        case "$mode" in
            ours)   echo "$ours";   exit 0 ;;
            theirs) echo "$theirs"; exit 0 ;;
        esac
        # Make sure both commits are present locally so ancestry/date checks work.
        git fetch --all --quiet 2>/dev/null || true
        local have_o=0 have_t=0
        git cat-file -e "${ours}^{commit}"   2>/dev/null && have_o=1
        git cat-file -e "${theirs}^{commit}" 2>/dev/null && have_t=1
        if [[ "$have_o" -eq 1 && "$have_t" -eq 0 ]]; then echo "$ours";   exit 0; fi
        if [[ "$have_t" -eq 1 && "$have_o" -eq 0 ]]; then echo "$theirs"; exit 0; fi
        if [[ "$have_o" -eq 0 && "$have_t" -eq 0 ]]; then echo "$ours";   exit 0; fi
        # Prefer the descendant (it already contains the other side's history).
        if git merge-base --is-ancestor "$ours" "$theirs" 2>/dev/null; then echo "$theirs"; exit 0; fi
        if git merge-base --is-ancestor "$theirs" "$ours" 2>/dev/null; then echo "$ours";   exit 0; fi
        # Diverged: newest committer date wins.
        local do_ dt_
        do_="$(git show -s --format=%ct "$ours"   2>/dev/null || echo 0)"
        dt_="$(git show -s --format=%ct "$theirs" 2>/dev/null || echo 0)"
        if [[ "${dt_:-0}" -gt "${do_:-0}" ]]; then echo "$theirs"; else echo "$ours"; fi
    )
}

# Resolve a submodule pointer conflict by recording a single chosen commit.
resolve_submodule_conflict() {
    local path="$1"
    local ours theirs pick
    ours="$(git rev-parse ":2:$path" 2>/dev/null || true)"   # stage 2 (ours)
    theirs="$(git rev-parse ":3:$path" 2>/dev/null || true)" # stage 3 (theirs)

    # Add/edit and edit/delete variants: take whichever side has a commit.
    if [[ -z "$ours" && -n "$theirs" ]]; then
        pick="$theirs"
    elif [[ -z "$theirs" && -n "$ours" ]]; then
        pick="$ours"
    elif [[ -n "$ours" && "$ours" == "$theirs" ]]; then
        pick="$ours"
    elif [[ -n "$ours" && -n "$theirs" ]]; then
        pick="$(select_submodule_commit "$path" "$ours" "$theirs")"
    else
        error "Submodule $path has no recorded commits on either side; cannot auto-resolve"
        return 1
    fi
    [[ -z "$pick" ]] && { error "Could not determine a commit for submodule $path"; return 1; }

    log "Submodule $path: ours=${ours:0:9} theirs=${theirs:0:9} -> keeping ${pick:0:9}"
    # Best-effort: move the submodule working tree onto the chosen commit so the
    # superproject isn't left showing it as modified. Never fatal if it can't.
    ( cd "$path" 2>/dev/null && git checkout -q "$pick" 2>/dev/null ) || true
    # Authoritatively record the chosen gitlink and clear the unmerged stages.
    if git update-index --cacheinfo "160000,$pick,$path" 2>/dev/null \
        || git update-index --cacheinfo 160000 "$pick" "$path" 2>/dev/null \
        || git add -- "$path" 2>/dev/null; then
        success "Resolved submodule $path -> ${pick:0:12}"
        return 0
    fi
    error "Failed to record resolved commit for submodule $path"
    return 1
}

# Get list of conflicted files
get_conflicted_files() {
    git diff --name-only --diff-filter=U 2>/dev/null || true
}

# Get conflict details for a file
get_conflict_details() {
    local file="$1"
    echo "=== CONFLICT DETAILS FOR: $file ==="
    echo ""
    echo "--- Git Status ---"
    git status --porcelain "$file" 2>/dev/null || true
    echo ""
    echo "--- Diff (ours vs theirs) ---"
    git diff :1:"$file" :2:"$file" 2>/dev/null | head -50 || true
    echo ""
    echo "--- Their Changes ---"
    git diff :1:"$file" :3:"$file" 2>/dev/null | head -50 || true
    echo ""
    echo "--- Conflict Markers in File ---"
    grep -n "<<<<<<<\|=======\|>>>>>>>" "$file" 2>/dev/null | head -20 || true
    echo ""
    echo "--- File Content (with context) ---"
    head -100 "$file" 2>/dev/null || true
}

# Read config value from TOML (simple key = "value" parsing).
# Strips inline `# comments` (so `provider = "kimi" # [...]` yields `kimi`) and
# ALL whitespace - safe only for single-token values like provider/model. For
# values that may contain spaces (e.g. an op:// ref) use read_config_value.
read_config() {
    local key="$1"
    if [[ ! -f "$CONFIG_FILE" ]]; then
        error "Config not found: $CONFIG_FILE"
        error "Run 'make install' from the GitMark directory or create it manually."
        exit 1
    fi
    grep -E "^${key}\s*=" "$CONFIG_FILE" | sed 's/#.*//' | sed 's/.*=\s*"\?\([^"]*\)"\?/\1/' | tr -d '[:space:]' | head -n1
}

# Space-preserving TOML value reader (quote-aware). Returns the double-quoted
# value verbatim, or the bare token with trailing #comment + whitespace trimmed.
read_config_value() {
    local key="$1"
    [[ -f "$CONFIG_FILE" ]] || return 0
    awk -v k="$key" '
        $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
            sub(/^[^=]*=/, "")
            if (match($0, /"[^"]*"/)) { print substr($0, RSTART+1, RLENGTH-2); exit }
            sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit
        }' "$CONFIG_FILE"
}

# Dereference a secret that may be a 1Password op:// reference (via `op read`,
# needs OP_SERVICE_ACCOUNT_TOKEN or a signed-in session). Literals pass through.
resolve_secret() {
    local v="$1"
    [[ -z "$v" ]] && return 0
    case "$v" in
        op://*)
            command -v op >/dev/null 2>&1 || return 0
            op read "$v" 2>/dev/null || true
            ;;
        *) printf '%s' "$v" ;;
    esac
}

# Call OpenRouter-compatible API
call_ai() {
    local prompt="$1"
    local provider model api_key api_url

    provider=$(read_config "provider")
    model=$(read_config "model")

    local env_key key_ref temp
    case "$provider" in
        openrouter)
            api_url="https://openrouter.ai/api/v1/chat/completions"; env_key="${OPENROUTER_API_KEY:-}"
            ;;
        kimi)
            # Kimi for Coding (Moonshot AI) - OpenAI-compatible endpoint.
            # Use model = "kimi-for-coding" (stable id; backend maps to latest).
            api_url="https://api.kimi.com/coding/v1/chat/completions"; env_key="${KIMI_API_KEY:-}"
            ;;
        openai)
            api_url="https://api.openai.com/v1/chat/completions"; env_key="${OPENAI_API_KEY:-}"
            ;;
        ollama)
            api_url="${OLLAMA_HOST:-http://localhost:11434}/v1/chat/completions"; env_key=""
            ;;
        *)
            error "Unsupported provider: $provider"
            return 1
            ;;
    esac

    # Key precedence: config `api_key` (may be a 1Password op:// ref) over the
    # provider env var, so a GitMark-specific key is used when present.
    key_ref="$(read_config_value api_key)"
    api_key="$(resolve_secret "$key_ref")"
    [[ -z "$api_key" ]] && api_key="$(resolve_secret "$env_key")"

    if [[ "$provider" != "ollama" && -z "$api_key" ]]; then
        error "No API key for provider '$provider' (checked config api_key + ${provider^^}_API_KEY)"
        return 1
    fi

    local auth_header=""
    if [[ -n "$api_key" ]]; then
        auth_header="Authorization: Bearer $api_key"
    fi

    # kimi-for-coding rejects any temperature except 1.
    temp="0.2"; [[ "$provider" == "kimi" ]] && temp="1"

    local response
    response=$(curl -s --max-time 60 "$api_url" \
        -H "Content-Type: application/json" \
        ${auth_header:+-H "$auth_header"} \
        -d "$(jq -n --arg model "$model" --arg prompt "$prompt" --argjson temp "$temp" '{
            model: $model,
            messages: [{ role: "user", content: $prompt }],
            temperature: $temp
        }')" 2>/dev/null)

    if [[ -z "$response" ]]; then
        return 1
    fi

    echo "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null
}

# Analyze conflict and get AI resolution recommendation
analyze_conflict_with_ai() {
    local conflict_details="$1"
    local file="$2"

    local prompt="You are a git conflict resolution expert. Analyze this git conflict and recommend the best resolution strategy.

$conflict_details

Based on the conflict above, respond with EXACTLY ONE of these strategies:

1. KEEP_OURS - Use our version (current branch changes)
2. KEEP_THEIRS - Accept their version (incoming changes)
3. RESOLVE_MARKERS - Resolve by intelligently combining both versions
4. ABORT - Cannot resolve automatically, needs manual intervention

Respond in this exact format:
STRATEGY: <strategy_name>
REASON: <brief explanation of why this strategy is best>

Guidelines for choosing:
- KEEP_OURS for local config, environment-specific files, work-in-progress
- KEEP_THEIRS for upstream fixes, dependency updates, documentation
- RESOLVE_MARKERS when both sides have valuable changes that can be merged
- ABORT for complex refactoring, API signature changes, or when uncertain"

    local model
    model=$(read_config "model")
    log "Consulting $model for resolution strategy..."

    local ai_response
    ai_response=$(call_ai "$prompt" || echo "STRATEGY: ABORT
REASON: AI API error")

    echo "$ai_response"
}

# Apply resolution based on strategy
apply_resolution() {
    local file="$1"
    local strategy="$2"
    local conflict_details="$3"

    case "$strategy" in
        "KEEP_OURS")
            log "Applying KEEP_OURS for $file"
            git checkout --ours "$file"
            git add "$file"
            success "Resolved $file: kept our version"
            return 0
            ;;
        "KEEP_THEIRS")
            log "Applying KEEP_THEIRS for $file"
            git checkout --theirs "$file"
            git add "$file"
            success "Resolved $file: accepted their version"
            return 0
            ;;
        "RESOLVE_MARKERS")
            log "Attempting intelligent marker resolution for $file"
            if resolve_conflict_markers "$file" "$conflict_details"; then
                git add "$file"
                success "Resolved $file: intelligent merge applied"
                return 0
            else
                warn "Failed to resolve markers intelligently for $file"
                return 1
            fi
            ;;
        "ABORT")
            error "AI recommends ABORT for $file - requires manual resolution"
            return 1
            ;;
        *)
            warn "Unknown strategy: $strategy, trying heuristic resolution"
            return 1
            ;;
    esac
}

# Try to resolve conflict markers intelligently
resolve_conflict_markers() {
    local file="$1"
    local conflict_details="$2"

    local file_content
    file_content=$(cat "$file")

    local prompt="You are resolving a git conflict. Here is the file with conflict markers:

File: $file

$file_content

Please resolve the conflict by:
1. Choosing the best version OR combining both intelligently
2. Removing all conflict markers (<<<<<<<, =======, >>>>>>>)
3. Ensuring the result is syntactically valid (if code) and logically correct

Respond ONLY with the resolved file content, no explanations."

    log "Asking AI to resolve conflict markers in $file..."

    local resolved_content
    resolved_content=$(call_ai "$prompt")

    if [[ -n "$resolved_content" ]] && ! echo "$resolved_content" | grep -q "<<<<<<<"; then
        echo "$resolved_content" > "$file"
        return 0
    fi

    return 1
}

# Heuristic resolution when AI is unavailable
heuristic_resolution() {
    local file="$1"

    log "Applying heuristic resolution for $file"

    # Determine file type and apply appropriate strategy
    if echo "$file" | grep -qE "\.(lock|json\.lock|yarn\.lock|package-lock\.json|poetry\.lock|Cargo\.lock)$"; then
        # Lock files: typically accept theirs for updates
        git checkout --theirs "$file"
        git add "$file"
        success "Resolved $file (lock file): accepted their version"
        return 0
    fi

    if echo "$file" | grep -qE "(\.env|local\.json|\.local\.|config\.local)"; then
        # Local config files: keep ours
        git checkout --ours "$file"
        git add "$file"
        success "Resolved $file (local config): kept our version"
        return 0
    fi

    if echo "$file" | grep -qE "(README|CHANGELOG|LICENSE|\.md)$"; then
        # Documentation: accept theirs (usually updates)
        git checkout --theirs "$file"
        git add "$file"
        success "Resolved $file (documentation): accepted their version"
        return 0
    fi

    # Default: try simple resolution
    if git checkout --theirs "$file" 2>/dev/null; then
        git add "$file"
        success "Resolved $file: accepted their version (default)"
        return 0
    fi

    return 1
}

# Resolve a single file
resolve_file() {
    local file="$1"

    log "Resolving conflicts in: $file"

    # Submodule (gitlink) conflicts are structural, not textual: resolve them
    # deterministically and skip the AI/marker path entirely (a directory has no
    # conflict markers to read).
    if is_submodule_path "$file"; then
        log "Conflicted path is a submodule (gitlink): $file"
        if resolve_submodule_conflict "$file"; then
            return 0
        fi
        error "Could not resolve submodule conflict for $file"
        return 1
    fi

    local conflict_details
    conflict_details=$(get_conflict_details "$file")

    # Try AI analysis first
    local ai_response
    ai_response=$(analyze_conflict_with_ai "$conflict_details" "$file" 2>/dev/null || echo "STRATEGY: ABORT")

    local strategy
    strategy=$(echo "$ai_response" | grep "^STRATEGY:" | cut -d: -f2 | tr -d ' ' || echo "ABORT")
    local reason
    reason=$(echo "$ai_response" | grep "^REASON:" | cut -d: -f2- || echo "No reason provided")

    log "AI Strategy: $strategy"
    log "AI Reason: $reason"

    if apply_resolution "$file" "$strategy" "$conflict_details"; then
        return 0
    fi

    # Fallback to heuristic
    if heuristic_resolution "$file"; then
        return 0
    fi

    error "Could not resolve $file automatically"
    return 1
}

# Main resolution flow
resolve_conflicts() {
    local failed_files=()
    local resolved_count=0

    log "Starting AI-powered conflict resolution..."
    log "Mode: $RESOLUTION_MODE"

    local conflicted_files
    conflicted_files=$(get_conflicted_files)

    if [[ -z "$conflicted_files" ]]; then
        warn "No conflicted files found"
        return 0
    fi

    log "Found $(echo "$conflicted_files" | wc -l) conflicted file(s)"

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue

        if resolve_file "$file"; then
            resolved_count=$((resolved_count + 1))
        else
            failed_files+=("$file")
        fi
    done <<< "$conflicted_files"

    # Summary
    echo ""
    log "=== Resolution Summary ==="
    success "Resolved: $resolved_count file(s)"

    if [[ ${#failed_files[@]} -gt 0 ]]; then
        error "Failed to resolve: ${#failed_files[@]} file(s)"
        for f in "${failed_files[@]}"; do
            echo "  - $f"
        done
        return 1
    fi

    return 0
}

# Continue the rebase/merge after resolution.
# Returns: 0 = operation finished, 2 = more conflicts to resolve, 1 = hard failure.
# Runs NON-INTERACTIVELY: GIT_EDITOR/GIT_SEQUENCE_EDITOR=true so a cron run with
# no TTY never blocks on an editor. A rebased commit whose changes were fully
# absorbed by the resolution becomes empty; git refuses to --continue it, so we
# --skip it (dropping a now-redundant patch is the correct outcome).
continue_operation() {
    log "Continuing $RESOLUTION_MODE..."

    if [[ "$RESOLUTION_MODE" == "rebase" ]]; then
        while true; do
            if GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true git rebase --continue >/dev/null 2>&1; then
                rebase_in_progress || { success "Rebase continued successfully"; return 0; }
                continue
            fi
            if is_in_conflict; then
                warn "Rebase still has conflicts, continuing resolution..."
                return 2
            fi
            if rebase_in_progress; then
                warn "Rebased commit is empty after resolution; skipping it."
                if GIT_EDITOR=true git rebase --skip >/dev/null 2>&1; then
                    is_in_conflict && return 2
                    rebase_in_progress && continue
                    success "Rebase completed after skipping empty commit"
                    return 0
                fi
                error "Rebase failed to continue (skip failed)"
                return 1
            fi
            success "Rebase continued successfully"
            return 0
        done
    elif [[ "$RESOLUTION_MODE" == "merge" ]]; then
        if GIT_EDITOR=true git merge --continue >/dev/null 2>&1 \
            || GIT_EDITOR=true git commit --no-edit >/dev/null 2>&1; then
            success "Merge completed successfully"
            return 0
        fi
        if is_in_conflict; then
            warn "Merge still has conflicts, continuing resolution..."
            return 2
        fi
        error "Merge failed to continue"
        return 1
    fi

    return 0
}

# Abort current operation
abort_operation() {
    log "Aborting current $RESOLUTION_MODE..."

    if [[ "$RESOLUTION_MODE" == "rebase" ]]; then
        git rebase --abort 2>/dev/null || true
    elif [[ "$RESOLUTION_MODE" == "merge" ]]; then
        git merge --abort 2>/dev/null || true
    fi

    success "Operation aborted"
}

# Main function
main() {
    log "GitMark resolver starting..."

    # Check if we're in a git repo
    if ! git rev-parse --git-dir &>/dev/null; then
        error "Not in a git repository"
        exit 1
    fi

    # Check for conflicts
    if ! is_in_conflict; then
        log "No conflicts detected - nothing to resolve"
        exit 0
    fi

    # Detect operation mode if not specified (git-dir aware: works in submodules)
    if rebase_in_progress; then
        RESOLUTION_MODE="rebase"
    elif merge_in_progress; then
        RESOLUTION_MODE="merge"
    fi

    log "Detected operation: $RESOLUTION_MODE"

    # Show configured provider/model
    local provider model
    provider=$(read_config "provider")
    model=$(read_config "model")
    log "Provider: $provider | Model: $model"

    # Resolve conflicts (with retry loop)
    local max_iterations=5
    local iteration=0

    while is_in_conflict && [[ $iteration -lt $max_iterations ]]; do
        iteration=$((iteration + 1))
        log "Resolution attempt $iteration of $max_iterations"

        if resolve_conflicts; then
            if ! is_in_conflict; then
                success "All conflicts resolved!"
                break
            fi

            # Try to continue operation
            local continue_result
            if continue_operation; then
                break
            elif [[ $? -eq 2 ]]; then
                # Still have conflicts, continue loop
                continue
            else
                error "Failed to continue operation"
                exit 1
            fi
        else
            error "Conflict resolution failed"

            # Show remaining conflicts
            local remaining
            remaining=$(get_conflicted_files)
            if [[ -n "$remaining" ]]; then
                error "Remaining conflicts:"
                echo "$remaining" | while read -r f; do
                    echo "  - $f"
                done
            fi

            exit 1
        fi
    done

    if is_in_conflict; then
        error "Could not resolve all conflicts after $max_iterations attempts"
        exit 1
    fi

    success "Conflict resolution complete!"
    exit 0
}

# Handle abort signal
trap 'error "Interrupted"; abort_operation; exit 130' INT TERM

main "$@"
