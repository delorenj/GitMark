#!/bin/bash
# git-checkpoint - git checkpoint with AI conflict resolution
# Part of GitMark - https://github.com/delorenj/GitMark
#
# Usage: git-checkpoint [repository_root_path]
#   repository_root_path   Optional. Defaults to the current directory.
#
# Environment:
#   GITMARK_SUBMODULE_SYNC=1  Advance CLEAN submodules to their default-branch
#                             tip. OFF by default: clean submodules are left at
#                             the commit pinned by the parent repo (the safe
#                             default - avoids silently moving submodule pointers).
#   NO_COLOR=1                Disable ANSI color in output.
#   GITMARK_FAST=1            Skip AI narration; use a fast timestamp message.
#                             (Also: pass --fast / --no-narrate as a flag.)
#   GITMARK_NARRATE=0         Disable AI narration entirely.
#   GITMARK_NARRATE_TIMEOUT   Seconds to allow for narration (default 45). On
#                             timeout/failure the commit still happens with a
#                             deterministic message - narration never blocks it.
#   GITMARK_CANDYSTORE_URL    candystore query API used for the "why" of the
#                             commit (default http://127.0.0.1:8683).
#
# Notes:
#   - Secret protection is BUILT IN (see secret_guard): before every commit the
#     staged set is scrubbed of known-secret paths (.env, shell_snapshots/,
#     private keys) and aborted if staged additions contain high-signal secret
#     material. This runs regardless of whether the target repo has hooks
#     installed, so a wiped/overwritten .gitignore can no longer leak secrets.
#     Override a false positive with GITMARK_ALLOW_SECRETS=1.
#   - Commits ALSO run through the repo's normal pre-commit hooks (e.g. GitMark's
#     lefthook secrets-check). This script NEVER uses --no-verify, so a hook
#     that blocks a commit correctly aborts the checkpoint with a non-zero exit.
#   - Pushes likewise run the repo's pre-push hooks. A push can be rejected for
#     reasons a rebase CANNOT fix - a failing pre-push gate (lint/format/test), a
#     server-side rule (protected branch / pre-receive hook), or an unreachable
#     remote. The push recovery only fetches+rebases when the branch is actually
#     BEHIND origin; otherwise it diagnoses the real cause and stops, instead of
#     looping a pointless rebase and reporting a misleading sync error.
#   - ALLOW_NO_TICKET is exported so that a commit-msg hook enforcing ticket
#     references will permit these automated checkpoint commits.
#   - Router-created wip/* and checkpoint/* branches are temporary safety lanes:
#     after a successful checkpoint they are merged back into the detected
#     default branch, the default branch is pushed, and it remains checked out.
#     Any integration failure preserves the checkpoint branch and exits non-zero.
#   - Commit messages are NARRATED by bin/gitmark-narrate: it blends the agent
#     session's prompts + tool calls (bloodbank events via candystore) with the
#     staged diff and asks a fast LLM for a Conventional-Commits message. This is
#     strictly best-effort and time-bounded: if candystore or the LLM is down/slow
#     it falls back to a deterministic diff-summary (and finally a timestamp), so
#     the checkpoint is never blocked. Disable with GITMARK_FAST=1 / --fast.

set -euo pipefail

# ALLOW_NO_TICKET: let any commit-msg ticket-enforcement hook accept auto commits.
export ALLOW_NO_TICKET=1

# --- Resolve SCRIPT_DIR through symlinks (portable, no GNU readlink -f) ---
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
AI_RESOLVER="${GITMARK_AI_RESOLVER:-$SCRIPT_DIR/git-ai-resolver}"
NARRATE_BIN="$SCRIPT_DIR/gitmark-narrate"
ROUTE_BIN="${GITMARK_ROUTE_BIN:-$SCRIPT_DIR/gitmark-route}"

# Propagate hook mode to subprocesses (e.g. git-ai-resolver), which may choose to
# disable external LLM calls when running non-interactively.
[[ -n "${GITMARK_HOOK:-}" ]] && export GITMARK_HOOK

# --- Colors: only when stdout is a TTY and NO_COLOR is unset ---
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'
else
  GREEN=''; YELLOW=''; RED=''; BLUE=''; NC=''
fi
log()     { echo -e "${BLUE}[gitmark]${NC} $1"; }
warn()    { echo -e "${YELLOW}[gitmark] WARNING:${NC} $1" >&2; }
error()   { echo -e "${RED}[gitmark] ERROR:${NC} $1" >&2; }
success() { echo -e "${GREEN}[gitmark]${NC} $1"; }

# Snapshot and restore the index so a failed commit after "git add -A" does not
# destroy the user's original staged/unstaged state. A repository may validly
# have no index yet; rollback must restore that absence instead of failing while
# trying to copy a file that does not exist.
backup_index() {
  local index_path
  index_path="$(git rev-parse --git-path index)"
  INDEX_BACKUP="$(mktemp 2>/dev/null || true)"
  if [[ -z "$INDEX_BACKUP" ]]; then
    error "Could not create a temporary index backup"
    return 1
  fi
  if [[ -f "$index_path" ]]; then
    if ! cp "$index_path" "$INDEX_BACKUP"; then
      rm -f "$INDEX_BACKUP"
      INDEX_BACKUP=""
      error "Could not back up the current index"
      return 1
    fi
    INDEX_WAS_PRESENT=1
  else
    INDEX_WAS_PRESENT=0
  fi
}
restore_index() {
  if [[ -n "${INDEX_BACKUP:-}" && -f "$INDEX_BACKUP" ]]; then
    local index_path
    index_path="$(git rev-parse --git-path index)"
    if [[ "$INDEX_WAS_PRESENT" == "1" ]]; then
      cp "$INDEX_BACKUP" "$index_path" || return 1
    else
      rm -f "$index_path" || return 1
    fi
    rm -f "$INDEX_BACKUP"
    INDEX_BACKUP=""
  fi
}

usage() {
  cat <<'EOF'
Usage: git-checkpoint [repository_root_path]

Stages all changes, commits a checkpoint with an AI-narrated message, integrates
with the default branch, and pushes. Router-created wip/* and checkpoint/*
branches are merged back into the default branch, and a successful run finishes
with the default branch checked out. Handles submodules. Conflicts are resolved
with the GitMark AI resolver when available.

The commit message is derived by bin/gitmark-narrate from the agent session's
prompts + tool calls (bloodbank/candystore) and the staged diff. It is
best-effort and time-bounded; if unavailable the checkpoint falls back to a
deterministic message and never blocks.

Arguments:
  repository_root_path   Optional. Defaults to the current directory.

Options:
  --fast, --no-narrate   Skip AI narration (fast timestamp/diff message).

Environment:
  GITMARK_SUBMODULE_SYNC=1   Advance clean submodules to their branch tip.
  GITMARK_FAST=1             Skip AI narration.
  GITMARK_NARRATE=0          Disable AI narration entirely.
  GITMARK_NARRATE_TIMEOUT    Seconds allowed for narration (default 45).
  GITMARK_CANDYSTORE_URL     candystore query API (default http://127.0.0.1:8683).
  NO_COLOR=1                 Disable colored output.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# --- Options (consume leading flags; leave the positional repo path intact) ---
NARRATE="${GITMARK_NARRATE:-1}"
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --fast|--no-narrate) NARRATE=0; shift ;;
    --narrate)           NARRATE=1; shift ;;
    --)                  shift; break ;;
    *)                   break ;;
  esac
done
[[ "${GITMARK_FAST:-0}" == "1" ]] && NARRATE=0

# --- Overall exit status. record_failure() flips it without aborting the run ---
EXIT_CODE=0
record_failure() { EXIT_CODE=1; error "$1"; }

# --- Routing: when on the default branch, an agentic judgment call
#     (gitmark-route) may first divert this checkpoint to a recoverable wip/*
#     or checkpoint/* safety branch. Successful safety branches are always
#     integrated back into the default branch before completion. ---
ROUTED=0
CHECKPOINT_BRANCH=0
CHECKPOINT_COMMITTED=0
ORIGINAL_BRANCH=""

# --- Is the repo currently mid-conflict (rebase/merge/cherry-pick/unmerged)? ---
repo_in_conflict() {
  local gd
  gd="$(git rev-parse --git-dir 2>/dev/null)" || return 1
  if [[ -d "$gd/rebase-merge" || -d "$gd/rebase-apply" ]]; then return 0; fi
  if [[ -f "$gd/MERGE_HEAD" || -f "$gd/CHERRY_PICK_HEAD" || -f "$gd/REVERT_HEAD" ]]; then return 0; fi
  if git diff --name-only --diff-filter=U 2>/dev/null | grep -q .; then return 0; fi
  return 1
}

# --- Determine the default branch authoritatively, then fall back ---
# Prefer origin/HEAD (set at clone). Fall back to main, THEN master, so a repo
# that has both origin/main and origin/master does not wrongly pick master.
detect_default_branch() {
  local ref
  if ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)" && [[ -n "$ref" ]]; then
    echo "${ref#refs/remotes/origin/}"; return 0
  fi
  if git show-ref --verify --quiet refs/remotes/origin/main; then echo "main"; return 0; fi
  if git show-ref --verify --quiet refs/remotes/origin/master; then echo "master"; return 0; fi
  echo "main"
}

# --- Cleanup on interrupt: restore index and abort only operations WE started ---
WE_STARTED_REBASE=0
WE_STARTED_MERGE=0
MSG_TMP=""     # commit-message temp file; removed by the trap if we're interrupted
INDEX_BACKUP=""  # backed-up index file if we staged but haven't committed
INDEX_WAS_PRESENT=0
cleanup() {
  if [[ -n "${INDEX_BACKUP:-}" && -f "$INDEX_BACKUP" ]]; then
    warn "Interrupted during staging/commit; restoring the original index."
    restore_index 2>/dev/null || true
  fi
  if [[ "$ROUTED" == "1" && "$CHECKPOINT_COMMITTED" == "0" && -n "$ORIGINAL_BRANCH" ]]; then
    warn "Interrupted before checkpoint commit; returning to '$ORIGINAL_BRANCH'."
    git switch "$ORIGINAL_BRANCH" >/dev/null 2>&1 \
      || git checkout "$ORIGINAL_BRANCH" >/dev/null 2>&1 \
      || error "Could not restore original branch '$ORIGINAL_BRANCH'"
  fi
  if [[ "$WE_STARTED_REBASE" == "1" ]] && repo_in_conflict; then
    warn "Interrupted during rebase; aborting to restore a clean state."
    if git rebase --abort; then
      WE_STARTED_REBASE=0
    else
      error "Could not abort rebase during cleanup; repository may be left mid-rebase"
    fi
  fi
  if [[ "$WE_STARTED_MERGE" == "1" ]] && repo_in_conflict; then
    warn "Interrupted during merge; aborting to restore the checkpoint branch."
    if git merge --abort; then
      WE_STARTED_MERGE=0
    else
      error "Could not abort merge during cleanup; repository may be left mid-merge"
    fi
  fi
  [[ -n "${PUSH_TMP:-}" ]] && rm -f "$PUSH_TMP" 2>/dev/null || true
  [[ -n "${MSG_TMP:-}" ]] && rm -f "$MSG_TMP" 2>/dev/null || true
}
trap cleanup INT TERM

# --- Push once, streaming AND capturing combined output into PUSH_OUT ---
# Uses `tee` so the user still sees live hook/push output, while we keep a copy
# to classify the failure. PIPESTATUS[0] (not the pipeline status) gives git's
# own exit code regardless of pipefail/tee.
PUSH_OUT=""
PUSH_TMP=""   # tracked so the INT/TERM trap can remove it if a push is interrupted
attempt_push() {
  local branch="$1" tmp st=0
  tmp="$(mktemp 2>/dev/null || echo "/tmp/gitmark-push.$$")"
  PUSH_TMP="$tmp"
  if git push origin "$branch" 2>&1 | tee "$tmp"; then st=0; else st="${PIPESTATUS[0]}"; fi
  PUSH_OUT="$(cat "$tmp" 2>/dev/null || true)"
  rm -f "$tmp"; PUSH_TMP=""
  return "$st"
}

# --- Classify WHY a push failed, from its captured output ---
# Echoes one of: nonff | remote | auth | hook | other
# This ONLY refines the diagnostic message - the decision to rebase is gated on
# is_behind_remote(), never on this string match - so a misclassification can at
# worst print a slightly-off reason, never rebase wrongly. Two ordering rules:
#   * remote/non-fast-forward rejections also print "failed to push some refs",
#     so they're matched BEFORE the generic hook case.
#   * a genuine auth/network failure fails EARLY with `fatal: ...` and never
#     prints "failed to push some refs"; a blocked pre-push hook DOES print it.
#     So "failed to push some refs" => hook is checked BEFORE the auth scan, so
#     a lint tool that happens to emit "permission denied"/"timeout" in its own
#     output can't masquerade as an auth error. Matches are case-insensitive so
#     e.g. GitHub's capitalized "Protected branch" still classifies as remote.
classify_push_failure() {
  local out="$1"
  if printf '%s' "$out" | grep -Eiq '\[remote rejected\]|pre-receive hook declined|protected branch|\bGH00[0-9]|push declined|cannot lock ref'; then
    echo remote; return 0
  fi
  if printf '%s' "$out" | grep -Eiq '\[rejected\]|\(non-fast-forward\)|\(fetch first\)|tip of your current branch is behind|Updates were rejected because'; then
    echo nonff; return 0
  fi
  if printf '%s' "$out" | grep -Eq 'failed to push some refs'; then
    echo hook; return 0
  fi
  if printf '%s' "$out" | grep -Eiq 'could not read from remote repository|permission denied|authentication failed|fatal: (could not|unable to) (access|read)|could not resolve host|connection (refused|timed out)|operation timed out|the remote end hung up|repository not found|does not appear to be a git repository|terminal prompts disabled'; then
    echo auth; return 0
  fi
  echo other; return 0
}

# --- Is the local branch genuinely BEHIND its remote tip? ---
# This - not the rejection message - is the authoritative test for "a rebase
# would help". Fetches just this branch (cheap) and compares via FETCH_HEAD,
# which is reliable regardless of remote-tracking refspec config. A failed
# fetch (unreachable remote) reports "not behind", so we never rebase blindly.
is_behind_remote() {
  local branch="$1" behind
  git fetch origin "$branch" >/dev/null 2>&1 || return 1
  behind="$(git rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)"
  [[ "$behind" =~ ^[0-9]+$ ]] && [[ "$behind" -gt 0 ]]
}

# --- Push with integrate-and-retry + AI conflict resolution (used everywhere) ---
# A push can fail for reasons a rebase CANNOT fix: a local pre-push hook
# (lint/format/test gate), a server-side rule (protected branch / pre-receive
# hook), or an unreachable remote (auth/network). Blindly rebasing on any push
# failure - the old behavior - wastes a fetch+rebase, then reports a misleading
# "Push still rejected after a clean rebase" that hides the true cause. So we
# only rebase when the branch is provably behind the remote, and otherwise
# diagnose the real reason and stop.
push_with_recovery() {
  local branch="$1"
  if attempt_push "$branch"; then
    success "Push successful"; return 0
  fi
  local kind; kind="$(classify_push_failure "$PUSH_OUT")"

  if is_behind_remote "$branch"; then
    warn "Push rejected; the remote has new commits. Fetching and rebasing before retry..."
    WE_STARTED_REBASE=1
    if git pull --rebase origin "$branch"; then
      WE_STARTED_REBASE=0
      if attempt_push "$branch"; then success "Push successful after rebase"; return 0; fi
      # Integrated cleanly but STILL can't push -> a local hook or remote rule,
      # not a sync problem. More rebasing won't help.
      case "$(classify_push_failure "$PUSH_OUT")" in
        hook)   error "Integrated remote changes, but a pre-push hook is still blocking the push (lint/format/test). Fix the issues reported above and re-run." ;;
        remote) error "Integrated remote changes, but the remote rejected the push (protected branch / pre-receive hook). Review the remote's rules above." ;;
        *)      error "Push still rejected after integrating remote changes; see the output above for the cause." ;;
      esac
      return 1
    fi
    # pull --rebase failed: distinguish a real conflict from network/auth/etc.
    if repo_in_conflict; then
      warn "Pull-rebase hit conflicts"
      if [[ -x "$AI_RESOLVER" ]]; then
        log "Invoking AI conflict resolver..."
        if "$AI_RESOLVER"; then
          WE_STARTED_REBASE=0
          if attempt_push "$branch"; then success "Push successful after AI resolution"; return 0; fi
          error "Push failed even after conflict resolution"; return 1
        fi
        error "AI resolver could not resolve conflicts; aborting rebase"
      else
        error "No AI resolver available; aborting rebase"
      fi
      if git rebase --abort; then
        WE_STARTED_REBASE=0
      else
        record_failure "Could not abort rebase after failed pull-rebase; repository may be left mid-rebase"
      fi
      return 1
    fi
    WE_STARTED_REBASE=0
    error "Pull-rebase failed (not a conflict - check network, auth, or upstream branch)"
    return 1
  fi

  # Not behind origin/$branch: a fetch+rebase cannot help. Diagnose precisely so
  # the user knows what to actually fix instead of chasing a phantom sync issue.
  case "$kind" in
    hook)
      error "Push blocked by a local pre-push hook (lint/format/test gate) - not a sync problem."
      error "Rebasing won't help; fix the issues reported above, then re-run the checkpoint."
      error "gitmark never bypasses hooks - to override deliberately, push manually with --no-verify."
      ;;
    remote)
      error "Push rejected by the remote (protected branch or pre-receive hook)."
      error "A rebase can't fix this; review the remote's rules in the output above."
      ;;
    auth)
      error "Push failed: the remote is unreachable (auth, network, or unknown host)."
      error "Check your credentials and connectivity; a rebase won't help here."
      ;;
    *)
      error "Push failed, and the branch is not behind origin/$branch, so a rebase would not help."
      error "See the push output above for the underlying cause."
      ;;
  esac
  return 1
}

# --- Prepare a GitMark-owned checkpoint branch for safe default integration ---
# Preserve both local default-branch commits and the latest fetched remote tip
# without rewriting the checkpoint commit. This guarantees that, after these
# merges succeed, the local default branch can fast-forward to the checkpoint
# branch. Conflicts use the same resolver contract as the rest of GitMark.
merge_ref_into_checkpoint() {
  local ref="$1"

  if git merge-base --is-ancestor "$ref" HEAD 2>/dev/null; then
    return 0
  fi

  log "Merging $ref into checkpoint branch $CURRENT_BRANCH..."
  WE_STARTED_MERGE=1
  if git merge --no-edit "$ref"; then
    WE_STARTED_MERGE=0
    success "Merged $ref into $CURRENT_BRANCH"
    return 0
  fi

  if repo_in_conflict; then
    warn "Merge from $ref hit conflicts"
    if [[ -x "$AI_RESOLVER" ]]; then
      log "Invoking AI conflict resolver for checkpoint integration..."
      if "$AI_RESOLVER" merge && ! repo_in_conflict; then
        WE_STARTED_MERGE=0
        success "AI resolver completed merge from $ref"
        return 0
      fi
      error "AI resolver could not complete merge from $ref"
    else
      error "No AI resolver available for merge from $ref"
    fi

    if git merge --abort; then
      WE_STARTED_MERGE=0
    else
      record_failure "Could not abort merge from $ref; repository may be left mid-merge"
    fi
    return 1
  fi

  WE_STARTED_MERGE=0
  error "Merge from $ref failed without a resolvable conflict"
  return 1
}

prepare_checkpoint_branch() {
  if ! git show-ref --verify --quiet "refs/heads/$DEFAULT_BRANCH"; then
    error "Local default branch '$DEFAULT_BRANCH' does not exist"
    return 1
  fi
  if ! git show-ref --verify --quiet "refs/remotes/origin/$DEFAULT_BRANCH"; then
    error "origin/$DEFAULT_BRANCH not found; cannot safely integrate checkpoint branch"
    return 1
  fi

  merge_ref_into_checkpoint "$DEFAULT_BRANCH" \
    && merge_ref_into_checkpoint "origin/$DEFAULT_BRANCH"
}

# --- Converge a successful GitMark-owned branch back into the default branch ---
# The checkpoint branch remains as a recoverable ref. We only claim success
# after the default branch fast-forwards, pushes, and is still checked out.
finish_checkpoint_branch() {
  local checkpoint_branch="$CURRENT_BRANCH"

  log "Integrating checkpoint branch '$checkpoint_branch' into '$DEFAULT_BRANCH'..."
  if ! git switch "$DEFAULT_BRANCH" 2>/dev/null \
    && ! git checkout "$DEFAULT_BRANCH" 2>/dev/null; then
    error "Could not switch to default branch '$DEFAULT_BRANCH'; preserving '$checkpoint_branch'"
    return 1
  fi
  CURRENT_BRANCH="$DEFAULT_BRANCH"

  if ! git merge --ff-only "$checkpoint_branch"; then
    error "Could not fast-forward '$DEFAULT_BRANCH' to '$checkpoint_branch'; checkpoint branch preserved"
    return 1
  fi

  log "Pushing integrated default branch $DEFAULT_BRANCH..."
  if ! push_with_recovery "$DEFAULT_BRANCH"; then
    error "Checkpoint is merged locally, but pushing '$DEFAULT_BRANCH' failed"
    return 1
  fi

  if [[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$DEFAULT_BRANCH" ]]; then
    error "Checkpoint integration finished on the wrong branch"
    return 1
  fi

  success "Checkpoint branch '$checkpoint_branch' merged into '$DEFAULT_BRANCH'; '$DEFAULT_BRANCH' is checked out."
}

# --- Built-in secret guard (defense-in-depth, runs regardless of repo hooks) ---
# The repo-hook secrets-check (lefthook) only protects repos that installed it.
# This guard runs unconditionally on the STAGED set, protecting every repo this
# script touches even if its .gitignore was wiped/overwritten or hooks are absent.
# Two layers:
#   1) PATH denylist  -> silently UNSTAGE files that must never be committed
#                        (.env, shell_snapshots/, private keys, ...). Safe
#                        templates (.env.example/.sample/.template/.dist/.op)
#                        are kept.
#   2) CONTENT scan   -> ABORT the checkpoint if staged additions contain
#                        high-signal secret material. Never auto-strips content;
#                        a hit means a human must look.
# Override (rare, for a genuine false positive): GITMARK_ALLOW_SECRETS=1
secret_guard() {
  [[ "${GITMARK_ALLOW_SECRETS:-0}" == "1" ]] && { warn "Secret-guard DISABLED via GITMARK_ALLOW_SECRETS=1"; return 0; }

  # --- Layer 1: unstage known-secret paths ---
  local f base
  local -a stripped=()
  while IFS= read -r -d '' f; do
    base="${f##*/}"
    case "$base" in
      *.example|*.sample|*.template|*.dist|*.op) continue ;;  # safe templates / 1Password refs
    esac
    case "$base" in
      .env|.env.*) stripped+=("$f") ;;
      *.shell_snapshot) stripped+=("$f") ;;
      *.pem|*.p12|*.pfx|*.key) stripped+=("$f") ;;
      id_rsa|id_dsa|id_ecdsa|id_ed25519|*_rsa|*_dsa|*_ecdsa|*_ed25519) stripped+=("$f") ;;
      *)
        case "$f" in
          shell_snapshots/*|*/shell_snapshots/*) stripped+=("$f") ;;
        esac ;;
    esac
  done < <(git diff --cached --name-only -z --diff-filter=ACM 2>/dev/null)

  if [[ ${#stripped[@]} -gt 0 ]]; then
    warn "Secret-guard: unstaging files that must never be committed:"
    for f in "${stripped[@]}"; do echo "      - $f" >&2; done
    git restore --staged -- "${stripped[@]}" 2>/dev/null \
      || git reset -q HEAD -- "${stripped[@]}" 2>/dev/null || true
  fi

  # --- Layer 2: scan staged ADDED lines for secret material; ABORT on hit ---
  local added pat
  added="$(git diff --cached --no-color -U0 --diff-filter=ACM 2>/dev/null | grep '^+' | grep -v '^+++' || true)"
  # High-signal patterns: GitHub tokens, AWS keys, Slack, 1Password service tokens,
  # Vault service tokens, common LLM API keys, PEM private keys.
  pat='ghp_[A-Za-z0-9]{36}|gh[osru]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{60,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|ops_[A-Za-z0-9_-]{40,}|hvs\.[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{24,}|sk-or-v1-[A-Za-z0-9]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  if [[ -n "$added" ]] && printf '%s\n' "$added" | grep -aEq "$pat"; then
    error "Secret-guard: staged content contains likely LIVE secrets. Checkpoint ABORTED."
    error "Matched (redacted):"
    printf '%s\n' "$added" | grep -aEo "$pat" | sed -E 's/(.{8}).*/\1…[REDACTED]/' | sort -u | sed 's/^/        /' >&2
    error "Remove the secret from the working tree (and from history if already committed),"
    error "or set GITMARK_ALLOW_SECRETS=1 to override for this run."
    return 1
  fi
}

# --- Agentic checkpoint router: create a recoverable checkpoint safety branch ---
# Called only when CURRENT_BRANCH == DEFAULT_BRANCH with staged changes. Asks
# gitmark-route for a decision; on "branch" it creates/switches to wip/<slug>
# (staged changes carry over) and marks it for mandatory integration back into
# the default branch. On any failure it diverts to a dated checkpoint/<date>
# branch. Only ever creates/switches wip|checkpoint branches. set -e safe.
route_checkpoint() {
  local decision route slug branch
  decision=""
  if [[ -x "$ROUTE_BIN" ]]; then
    decision="$("$ROUTE_BIN" --repo "$(pwd)" --default-branch "$DEFAULT_BRANCH" 2>/dev/null || true)"
  fi
  route="$(printf '%s' "$decision" | sed -n 's/.*"route"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' | head -1)"
  slug="$(printf '%s' "$decision" | sed -n 's/.*"slug"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  if [[ "$route" != "main" && "$route" != "branch" ]]; then
    route="branch"; slug=""
    warn "Router unavailable; diverting checkpoint off '$DEFAULT_BRANCH' to a dated branch."
  fi
  if [[ "$route" == "main" ]]; then
    log "Router: this change is fine on '$DEFAULT_BRANCH'; checkpointing there."
    return 0
  fi
  slug="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9/_-' '-' | sed -E 's/-+/-/g; s#^[-/]+##; s#[-/]+$##')"
  if [[ -n "$slug" ]]; then
    case "$slug" in wip/*|checkpoint/*) branch="$slug" ;; *) branch="wip/$slug" ;; esac
  else
    branch="checkpoint/$(date -u +%Y-%m-%d)"
  fi
  # Safety net: only ever create/switch a wip|checkpoint branch, never hijack a real one.
  case "$branch" in wip/*|checkpoint/*) : ;; *) branch="wip/$branch" ;; esac
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch" 2>/dev/null || git checkout "$branch" 2>/dev/null || true
  else
    git switch -c "$branch" 2>/dev/null || git checkout -b "$branch" 2>/dev/null || true
  fi
  if [[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" == "$branch" ]]; then
    CURRENT_BRANCH="$branch"; ROUTED=1; CHECKPOINT_BRANCH=1
    success "Router: diverted checkpoint '$DEFAULT_BRANCH' -> '$branch' (staged changes carried over)."
  else
    warn "Router: could not switch to '$branch'; checkpointing on '$DEFAULT_BRANCH' as before."
  fi
}

# ================================ main ================================
REPO_ROOT="${1:-$(pwd)}"

# Validate REPO_ROOT and require it to be the work-tree TOP LEVEL.
# rev-parse (not `[[ -d .git ]]`) supports submodules and linked worktrees,
# whose .git is a FILE, not a directory - fixing the old guard that rejected
# this script's own submodule recursion. Requiring the top level (rather than
# merely "inside a work tree") refuses a subdirectory path, so we never
# checkpoint an unrelated ENCLOSING repo by surprise.
if ! git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  error "Not a git repository: $REPO_ROOT"
  exit 1
fi
_top="$(git -C "$REPO_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$_top" ]] || [[ "$(cd "$_top" 2>/dev/null && pwd -P)" != "$(cd "$REPO_ROOT" 2>/dev/null && pwd -P)" ]]; then
  error "Not a repository root: $REPO_ROOT"
  error "Pass the top level of a repo or submodule; subdirectories are refused to avoid checkpointing an enclosing repo."
  exit 1
fi

cd "$REPO_ROOT" || { error "Cannot cd into: $REPO_ROOT"; exit 1; }
REPO_NAME="$(basename "$(pwd)")"

# --- Single-instance lock per repo, so concurrent runs can't corrupt state ---
GIT_DIR="$(git rev-parse --git-dir)"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$GIT_DIR/gitmark-checkpoint.lock"
  if ! flock -n 9; then
    log "Another git-checkpoint is already running for $REPO_NAME; skipping."
    exit 0
  fi
else
  warn "flock not found; running without a concurrency lock."
fi

echo "=== Checkpointing: $REPO_NAME ==="

# --- Resolve any pre-existing conflict before touching anything ---
if repo_in_conflict; then
  warn "Repository is in the middle of a conflicting operation"
  if [[ -x "$AI_RESOLVER" ]]; then
    log "Attempting to resolve existing conflicts with AI..."
    if "$AI_RESOLVER"; then
      success "Existing conflicts resolved"
    else
      error "Could not resolve existing conflicts; fix manually first"
      exit 1
    fi
  else
    error "Repository has unresolved conflicts; fix manually first"
    exit 1
  fi
fi

# --- Fetch once (all remotes, prune stale tracking refs) ---
echo "Fetching remotes..."
git fetch --all --prune || record_failure "fetch failed (continuing with cached refs)"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")"
echo "Current branch: $CURRENT_BRANCH"
DEFAULT_BRANCH="$(detect_default_branch)"
ORIGINAL_BRANCH="$CURRENT_BRANCH"
case "$CURRENT_BRANCH" in
  wip/*|checkpoint/*) CHECKPOINT_BRANCH=1 ;;
esac

# --- Detect submodules ---
HAS_SUBMODULES=false
if [[ -f ".gitmodules" && -s ".gitmodules" ]] && [[ -n "$(git submodule status 2>/dev/null)" ]]; then
  HAS_SUBMODULES=true
fi

if [[ "$HAS_SUBMODULES" == true ]]; then
  echo "Processing submodules..."
  git submodule update --init --recursive || record_failure "submodule update failed (continuing)"

  CHECKPOINT_BIN="$(command -v git-checkpoint 2>/dev/null || true)"
  [[ -z "$CHECKPOINT_BIN" ]] && CHECKPOINT_BIN="$SCRIPT_DIR/git-checkpoint"
  export CHECKPOINT_BIN

  # `git submodule foreach` runs each command via /bin/sh (dash on Debian/Ubuntu),
  # which has NO `[[ ]]`. Everything in the block below MUST stay POSIX sh: use
  # `[ ]` and `=`, not `[[ ]]`/`==`.
  #   dirty submodule -> recurse (commit + push its own contents)
  #   clean submodule -> left at its pinned commit, UNLESS GITMARK_SUBMODULE_SYNC=1
  # shellcheck disable=SC2016
  git submodule foreach '
    echo "--- Submodule: $name ---"
    if [ -n "$(git status --porcelain)" ]; then
      echo "  Dirty; running git-checkpoint..."
      "$CHECKPOINT_BIN" "$(pwd)" || echo "  WARNING: checkpoint failed for $name"
    elif [ "${GITMARK_SUBMODULE_SYNC:-0}" = "1" ]; then
      SUB_DEFAULT=main
      if git show-ref --verify --quiet refs/remotes/origin/main; then
        SUB_DEFAULT=main
      elif git show-ref --verify --quiet refs/remotes/origin/master; then
        SUB_DEFAULT=master
      fi
      SUB_CUR=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
      if [ "$SUB_CUR" != "$SUB_DEFAULT" ]; then
        git checkout "$SUB_DEFAULT" 2>/dev/null || { echo "  Could not switch to $SUB_DEFAULT; leaving as-is"; exit 0; }
      fi
      echo "  Advancing to origin/$SUB_DEFAULT..."
      git pull --ff-only origin "$SUB_DEFAULT" || echo "  WARNING: ff pull failed for $name"
    else
      echo "  Clean; left at pinned commit (set GITMARK_SUBMODULE_SYNC=1 to advance)."
    fi
  ' || record_failure "submodule processing reported errors"
fi

# --- Stage and commit ---
# Snapshot the index before "git add -A" so a failed commit can restore the
# user's original staged/unstaged state instead of destroying it.
echo "Staging all changes..."
if ! backup_index; then
  record_failure "Could not preserve the original index; checkpoint aborted"
  exit "$EXIT_CODE"
fi
if ! git add -A; then
  restore_index || record_failure "Could not restore the original index after git add failure"
  record_failure "git add -A failed"
  exit "$EXIT_CODE"
fi

# Built-in secret protection: unstage secret paths, abort on secret content.
# Runs even when the target repo has no pre-commit hooks installed.
if ! secret_guard; then
  restore_index || record_failure "Could not restore the original index after secret-guard rejection"
  record_failure "Secret-guard rejected the staged checkpoint; nothing was committed"
  exit "$EXIT_CODE"
fi

# Agentic route: keep the protected default branch clean. When we're on it with
# staged changes, gitmark-route may divert this checkpoint to a wip/* branch
# (staged changes carry over). Disable entirely with GITMARK_ROUTE=0.
if [[ "${GITMARK_ROUTE:-1}" == "1" && "$CURRENT_BRANCH" == "$DEFAULT_BRANCH" ]] && ! git diff --cached --quiet; then
  route_checkpoint
fi

if git diff --cached --quiet; then
  echo "No changes to commit"
  rm -f "$INDEX_BACKUP"; INDEX_BACKUP=""
else
  # Narrate the commit message from bloodbank events + the staged diff. This is
  # best-effort and TIME-BOUNDED: on timeout/failure/empty output we fall back to
  # a plain timestamp, so narration can never block or fail the checkpoint. The
  # message is written to a temp file and committed via `git commit -F` so a
  # multi-line narrative (subject + body) is preserved verbatim.
  SINCE_ISO="$(git log -1 --format=%cI 2>/dev/null || true)"
  MSG_TMP="$(mktemp 2>/dev/null || echo "$GIT_DIR/gitmark-msg.$$")"
  if [[ "$NARRATE" == "1" && -x "$NARRATE_BIN" ]]; then
    log "Deriving commit narrative (prompts + tool calls + diff)..."
    timeout "${GITMARK_NARRATE_TIMEOUT:-45}" \
      "$NARRATE_BIN" --repo "$(pwd)" ${SINCE_ISO:+--since "$SINCE_ISO"} \
      > "$MSG_TMP" 2>/dev/null || true
  fi
  if [[ ! -s "$MSG_TMP" ]]; then
    printf 'checkpoint: %s auto-commit\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$MSG_TMP"
  fi
  echo "Committing: $(head -n1 "$MSG_TMP")"
  # No --no-verify: pre-commit hooks (e.g. secrets-check) must be able to block this.
  if git commit -F "$MSG_TMP"; then
    CHECKPOINT_COMMITTED=1
    success "Committed"
    rm -f "$MSG_TMP"; MSG_TMP=""
    rm -f "$INDEX_BACKUP"; INDEX_BACKUP=""
  else
    rm -f "$MSG_TMP"; MSG_TMP=""
    restore_index || record_failure "Could not restore the original index after commit failure"
    if [[ "$ROUTED" == "1" && -n "$ORIGINAL_BRANCH" ]]; then
      if git switch "$ORIGINAL_BRANCH" >/dev/null 2>&1 \
        || git checkout "$ORIGINAL_BRANCH" >/dev/null 2>&1; then
        CURRENT_BRANCH="$ORIGINAL_BRANCH"
        success "Returned to original branch '$ORIGINAL_BRANCH'"
      else
        record_failure "Could not return to original branch '$ORIGINAL_BRANCH' after commit failure"
      fi
    fi
    record_failure "Commit failed (a pre-commit hook may have blocked it - e.g. a detected secret - or git identity is unset). Nothing was checkpointed."
    exit "$EXIT_CODE"
  fi
fi

# --- Integrate with the default branch (skip when already on it or detached) ---
REBASE_OK=1
if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  warn "Detached HEAD: skipping rebase and push."
elif [[ "$CURRENT_BRANCH" == "$DEFAULT_BRANCH" ]]; then
  : # already on the default branch - no rebase needed
elif [[ "$CHECKPOINT_BRANCH" == "1" ]]; then
  if [[ "$EXIT_CODE" -ne 0 ]]; then
    warn "Earlier failures prevent safe checkpoint-branch integration; preserving $CURRENT_BRANCH."
    REBASE_OK=0
  elif prepare_checkpoint_branch; then
    success "Checkpoint branch contains local and remote $DEFAULT_BRANCH"
  else
    record_failure "Could not prepare checkpoint branch for default-branch integration"
    REBASE_OK=0
  fi
else
  echo "Rebasing $CURRENT_BRANCH onto origin/$DEFAULT_BRANCH..."
  if ! git show-ref --verify --quiet "refs/remotes/origin/$DEFAULT_BRANCH"; then
    record_failure "origin/$DEFAULT_BRANCH not found; cannot rebase"
    REBASE_OK=0
  else
    WE_STARTED_REBASE=1
    if git rebase "origin/$DEFAULT_BRANCH"; then
      WE_STARTED_REBASE=0
      success "Rebase successful"
    elif [[ -x "$AI_RESOLVER" ]]; then
      warn "Rebase conflicts; invoking AI resolver..."
      if "$AI_RESOLVER"; then
        WE_STARTED_REBASE=0
        success "AI resolver handled rebase conflicts"
      else
        record_failure "AI resolver failed to resolve rebase conflicts; aborting rebase"
        if git rebase --abort; then
          WE_STARTED_REBASE=0
        else
          record_failure "Could not abort rebase; repository may be left mid-rebase"
        fi
        REBASE_OK=0
      fi
    else
      record_failure "Rebase conflicts and no AI resolver available; aborting rebase"
      if git rebase --abort; then
        WE_STARTED_REBASE=0
      else
        record_failure "Could not abort rebase; repository may be left mid-rebase"
      fi
      REBASE_OK=0
    fi
  fi
fi

# --- Push ---
if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
  : # detached: already warned, nothing to push
elif [[ "$REBASE_OK" != "1" ]]; then
  warn "Skipping push because the rebase did not complete cleanly."
else
  log "Pushing $CURRENT_BRANCH..."
  push_with_recovery "$CURRENT_BRANCH" || record_failure "Push failed for $CURRENT_BRANCH"
fi

# --- Update submodule pointers in the parent (same resilient push path) ---
if [[ "$HAS_SUBMODULES" == true && "$CURRENT_BRANCH" != "HEAD" && "$REBASE_OK" == "1" ]]; then
  git add -A || record_failure "git add for submodule pointers failed"
  if ! git diff --cached --quiet; then
    echo "Updating submodule pointers..."
    if git commit -m "checkpoint: update submodule pointers $(date -u +%Y-%m-%dT%H:%M:%SZ)"; then
      push_with_recovery "$CURRENT_BRANCH" || record_failure "Push failed for submodule-pointer update"
    else
      record_failure "Commit failed for submodule-pointer update"
    fi
  fi
fi

# Router-created and pre-existing wip/* or checkpoint/* branches are not a
# terminal state. Once every checkpoint operation is green, fast-forward the
# default branch to the checkpoint, push it, and leave it checked out.
if [[ "$CHECKPOINT_BRANCH" == "1" ]]; then
  if [[ "$EXIT_CODE" -eq 0 && "$REBASE_OK" == "1" ]]; then
    finish_checkpoint_branch \
      || record_failure "Could not converge checkpoint branch into $DEFAULT_BRANCH"
  else
    warn "Checkpoint branch '$CURRENT_BRANCH' was preserved because the run did not complete cleanly."
  fi
fi

if [[ "$EXIT_CODE" -eq 0 ]]; then
  success "=== Checkpoint complete: $REPO_NAME ==="
else
  error "=== Checkpoint finished WITH ERRORS: $REPO_NAME ==="
fi
exit "$EXIT_CODE"
