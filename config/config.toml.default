provider = "ollama"
model = "qwen3.5:35b"

# Optional: API key for the chosen provider. May be a literal key OR a 1Password
# reference (`op://vault/item/field`) resolved at runtime via `op read` (needs
# OP_SERVICE_ACCOUNT_TOKEN or a signed-in session). If unset, the provider env
# var is used (KIMI_API_KEY / AUTOMATICAI_API_KEY / OPENROUTER_API_KEY / OPENAI_API_KEY). Not needed
# for ollama. Example:
# api_key = "op://DeLoSecrets/Kimi/API Keys/GitMark"

# Other supported providers (uncomment ONE provider/model pair and set the
# matching API key env var). All use the OpenAI-compatible chat schema.
#
# OpenAI                 -> OPENAI_API_KEY
# provider = "openai"
# model = "gpt-4o-mini"
#
# OpenRouter             -> OPENROUTER_API_KEY  (also covers DeepSeek, etc.)
# provider = "openrouter"
# model = "deepseek/deepseek-v4-flash"
#
# Kimi for Coding        -> KIMI_API_KEY
# provider = "kimi"
# model = "kimi-for-coding"
#
# AutomaticAI gateway    -> AUTOMATICAI_API_KEY  (api.automaticai.io; no temperature sent)
# "automaticai/auto" lets the gateway's auto router pick the native model. With no
# tools and a body under 16 KB it routes to the fast tier; larger requests go to
# the orchestrator tier. Use "automaticai/auto/fast" to pin the fast tier.
# provider = "automaticai"
# model = "automaticai/auto"
# api_key = "op://DeLoSecrets/AutomaticAI Gateway Tokens/gitmark"

# --- Commit-message narration (bin/gitmark-narrate) ---------------------------
# git-checkpoint uses the provider/model above to narrate commit messages from
# the session's prompts + tool calls (bloodbank/candystore) plus the staged
# diff. This is best-effort and time-bounded; on failure it falls back to a
# deterministic diff-summary. Tune via environment (no config keys needed):
#   GITMARK_FAST=1                skip narration (fast timestamp message)
#   GITMARK_NARRATE=0             disable narration entirely
#   GITMARK_NARRATE_TIMEOUT=45    seconds allowed for narration
#   GITMARK_NARRATE_PROVIDER=...  override provider just for narration ("none" = off)
#   GITMARK_NARRATE_MODEL=...     override model just for narration
#   GITMARK_CANDYSTORE_URL=http://127.0.0.1:8683   candystore query API
